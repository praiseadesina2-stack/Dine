{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "typeRoots": ["./src/@types", "../../node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
