{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dine.local/contracts/tool-error.schema.json",
  "title": "ToolError",
  "description": "What every tool endpoint returns on failure. message is safe to show the model: no SQL, stack traces or other users' data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "NOT_FOUND",
            "NOT_DINNER",
            "UNAVAILABLE",
            "STALE_PRICE",
            "NO_PROFILE",
            "FEATURE_DISABLED",
            "RATE_LIMITED",
            "UPSTREAM_TIMEOUT",
            "INTERNAL"
          ]
        },
        "message": { "type": "string", "maxLength": 300 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
